rules_version = '2';

// Each user can read and write only their own documents (users/{uid} and everything under it).
// Sign-ups are disabled in Firebase Authentication, so there is a single user.
// The rest of the database is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
